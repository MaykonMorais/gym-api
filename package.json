    "@vitest/coverage-v8": "4.0.18",
    "@vitest/ui": "4.0.18",
    "eslint": "9.39.2",
    "globals": "17.1.0",
    "jiti": "2.6.1",
    "prisma": "7.3.0",
    "supertest": "7.2.2",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.53.1",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  },
  "dependencies": {
    "@fastify/jwt": "10.0.0",
